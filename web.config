<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="realtime.php" />
                <add value="Dashboard.php" />
            </files>
        </defaultDocument>

        <!-- Pass PHP error output through instead of replacing with IIS error page -->
        <!-- TEMPORARY: remove after diagnosing 500 -->
        <httpErrors existingResponse="PassThrough" />

        <!-- Security headers — applied to every response -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Frame-Options" value="DENY" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none'" />
            </customHeaders>
        </httpProtocol>

        <!-- Block direct access to /cache/ directory -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="cache" />
                    <add segment="logs" />
                </hiddenSegments>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
